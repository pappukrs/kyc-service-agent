# ---- Model provider -------------------------------------------------------
# LangChain/LangGraph are provider-agnostic. Set these two and nothing else
# in the codebase needs to know which provider you picked.
MODEL_PROVIDER=google          # google | openai | anthropic | ollama
MODEL_NAME=gemini-2.0-flash
MODEL_API_KEY=changeme

# ---- MongoDB --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kyc_servicing

# ---- Kafka ----------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TASKS_TOPIC=servicing.tasks
KAFKA_AUDIT_TOPIC=servicing.audit

# ---- Worker ---------------------------------------------------------------
# Simulated document-check duration. There is no real scanner behind this; the
# delay is what makes the async path observable end to end.
VERIFICATION_LATENCY_SECONDS=3.0

# ---- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=dev-only-change-me
LOG_LEVEL=INFO

# ---- Agent ----------------------------------------------------------------
AGENT_RUNTIME=langgraph        # langgraph | adk

# Bounds on a turn. MAX_TOOL_CALLS_PER_TURN caps a model that will not stop
# calling tools; the rest cap a tool that will not answer. Retries apply to read
# tools only — a write that timed out may already have committed, so a second
# attempt would be a guess about which. TOOL_DEADLINE_SECONDS bounds the whole
# call, retries and backoff included: without it a retry policy only multiplies
# the wait it was meant to bound.
MAX_TOOL_CALLS_PER_TURN=8
TOOL_TIMEOUT_SECONDS=15         # per attempt
TOOL_RETRY_ATTEMPTS=3           # reads only; 1 disables retrying
TOOL_RETRY_BACKOFF_SECONDS=0.25 # doubles after each failed attempt
TOOL_DEADLINE_SECONDS=25        # the whole call, retries included

# ---- Evals ----------------------------------------------------------------
# `make eval` grades the agent's replies with a second model. Left blank, that
# is the same model as the agent's — which marks its own homework more kindly
# than it should. Point it at a different one for any result you intend to
# quote at somebody.
EVAL_JUDGE_MODEL=
