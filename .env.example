# ---- Model provider -------------------------------------------------------
# LangChain/LangGraph are provider-agnostic. Set these two and nothing else
# in the codebase needs to know which provider you picked.
MODEL_PROVIDER=google          # google | openai | anthropic | ollama
MODEL_NAME=gemini-2.0-flash
MODEL_API_KEY=changeme

# ---- MongoDB --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kyc_servicing

# ---- Kafka ----------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TASKS_TOPIC=servicing.tasks
KAFKA_AUDIT_TOPIC=servicing.audit

# ---- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=dev-only-change-me
LOG_LEVEL=INFO

# ---- Agent ----------------------------------------------------------------
AGENT_RUNTIME=langgraph        # langgraph | adk
MAX_TOOL_CALLS_PER_TURN=8
TOOL_TIMEOUT_SECONDS=15
